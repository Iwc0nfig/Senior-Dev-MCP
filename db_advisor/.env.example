# Read-only SQL Server login for the 'appdb' database. Never commit or share the real file.
# Spaces around = and double quotes are optional.
URL = "sql-server-host-or-ip"
LOGIN = "readonly_login"
PASSWORDS = "password"

# Optional: only when config.toml [sandbox] auth = "sql" (default: Windows authentication).
# A login on the LOCAL sandbox SQL Server, never on the production server.
# SANDBOX_LOGIN = "sandbox_login"
# SANDBOX_PASSWORDS = "password"
